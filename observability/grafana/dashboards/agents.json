  },
  {
   "id": 3,
   "type": "stat",
   "title": "Resolved autonomously",
   "description": "",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
