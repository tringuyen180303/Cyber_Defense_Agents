    "x": 0,
    "y": 13,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 10,
   "type": "traces",
   "title": "Agent trace: detection → investigation → planning → sandbox → execution → verification",
   "description": "",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 24,
    "h": 14
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 3,
     "rawSql": "SELECT TraceId AS traceID, SpanId AS spanID, ParentSpanId AS parentSpanID, ServiceName AS serviceName, SpanName AS operationName, multiply(toUnixTimestamp64Nano(Timestamp), 0.000001) AS startTime, multiply(Duration, 0.000001) AS duration, arrayMap(key -> map('key', key, 'value', SpanAttributes[key]), mapKeys(SpanAttributes)) AS tags, arrayMap(key -> map('key', key, 'value', ResourceAttributes[key]), mapKeys(ResourceAttributes)) AS serviceTags, if(StatusCode = 'Error', 2, 0) AS statusCode, StatusMessage AS statusMessage, arrayMap((name, ts, attrs) -> tuple(multiply(toUnixTimestamp64Nano(ts), 0.000001), map('event', name), attrs)::Tuple(timestamp Float64, fields Map(String, String), attrs Map(String, String)), Events.Name, Events.Timestamp, Events.Attributes) AS logs FROM otel.otel_traces WHERE TraceId = '${trace_id}' ORDER BY startTime"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {},
   "transformations": []
  },
  {
   "id": 11,
   "type": "barchart",
   "title": "Where the time went (this trace)",
   "description": "",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 9,
    "h": 10
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "rawSql": "SELECT SpanName AS span, round(sum(Duration) / 1e6, 1) AS ms FROM otel.otel_traces WHERE TraceId = '${trace_id}' AND SpanName NOT IN ('incident') GROUP BY SpanName ORDER BY ms DESC LIMIT 15"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "options": {
    "xField": "span",
    "orientation": "horizontal",
    "showValue": "auto",
    "stacking": "none",
    "legend": {
     "showLegend": true,
     "displayMode": "list",
     "placement": "bottom"
    },
    "xTickLabelRotation": 0,
    "barWidth": 0.7,
    "groupWidth": 0.7
   },
   "transformations": []
  },
  {
   "id": 12,
   "type": "table",
   "title": "Sandbox attempts (this trace) — ablation pins the culprit action",
   "description": "",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 9,
    "y": 28,
    "w": 15,
    "h": 10
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "rawSql": "SELECT SpanAttributes['sentinel.attempt'] AS attempt, if(SpanAttributes['sentinel.passed'] = 'true', 'PASS', 'FAIL') AS result, concat(SpanAttributes['sentinel.checks_failed'], '/', SpanAttributes['sentinel.checks_total']) AS failed, SpanAttributes['sentinel.failed_checks'] AS failed_checks, SpanAttributes['sentinel.culprits'] AS culprits, round(Duration / 1e6, 1) AS ms FROM otel.otel_traces WHERE TraceId = '${trace_id}' AND SpanName = 'sandbox.attempt' ORDER BY Timestamp"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "result"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "PASS": {
            "color": "green",
            "index": 0
           },
           "FAIL": {
            "color": "red",
            "index": 1
           }
          }
         }
        ]
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   },
   "transformations": []
  },
  {
   "id": 13,
   "type": "logs",
   "title": "Agent log (this trace) — every line is correlated to its span",
   "description": "",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 38,
    "w": 24,
    "h": 12
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 2,
     "rawSql": "SELECT Timestamp AS timestamp, concat('[', LogAttributes['sentinel.agent'], '] ', Body) AS body, lower(SeverityText) AS level, LogAttributes['sentinel.kind'] AS kind, LogAttributes['sentinel.sim_time'] AS sim_time, LogAttributes['sentinel.evidence_ids'] AS evidence FROM otel.otel_logs WHERE TraceId = '${trace_id}' ORDER BY Timestamp"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Ascending",
    "enableLogDetails": true,
    "dedupStrategy": "none",
    "showLabels": false
   },
   "transformations": []
  },
  {
   "id": 14,
   "type": "row",
   "title": "LLM & tools across all incidents (GenAI semantic conventions)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 50,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 15,
   "type": "timeseries",
   "title": "LLM latency by agent",
   "description": "",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 51,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 0,
     "rawSql": "SELECT $__timeInterval(Timestamp) AS time, splitByChar('.', SpanAttributes['sentinel.llm.purpose'])[1] AS agent, avg(Duration) / 1e6 AS latency_ms FROM otel.otel_traces WHERE SpanAttributes['gen_ai.system'] = 'openai' AND $__timeFilter(Timestamp) GROUP BY time, agent ORDER BY time"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "points",
      "fillOpacity": 10,
      "lineWidth": 2,
      "showPoints": "auto",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "showLegend": true,
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "transformations": []
  },
  {
   "id": 16,
   "type": "barchart",
   "title": "Tokens by agent",
   "description": "",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 12,
    "y": 51,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "rawSql": "SELECT splitByChar('.', SpanAttributes['sentinel.llm.purpose'])[1] AS agent, sum(toUInt64OrZero(SpanAttributes['gen_ai.usage.input_tokens'])) AS input, sum(toUInt64OrZero(SpanAttributes['gen_ai.usage.output_tokens'])) AS output FROM otel.otel_traces WHERE SpanAttributes['gen_ai.system'] = 'openai' AND $__timeFilter(Timestamp) GROUP BY agent ORDER BY input DESC"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "options": {
    "xField": "agent",
    "orientation": "horizontal",
    "showValue": "auto",
    "stacking": "normal",
    "legend": {
     "showLegend": true,
     "displayMode": "list",
     "placement": "bottom"
    },
    "xTickLabelRotation": 0,
    "barWidth": 0.7,
    "groupWidth": 0.7
   },
   "transformations": []
  },
  {
   "id": 17,
   "type": "table",
   "title": "Tool calls",
   "description": "",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 60,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "rawSql": "SELECT SpanAttributes['sentinel.tool.name'] AS tool, SpanAttributes['sentinel.tool.chosen_by'] AS chosen_by, count() AS calls, round(avg(Duration) / 1e6, 2) AS avg_ms, round(quantile(0.95)(Duration) / 1e6, 2) AS p95_ms, countIf(StatusCode = 'Error') AS errors FROM otel.otel_traces WHERE SpanName LIKE 'tool %' AND $__timeFilter(Timestamp) GROUP BY tool, chosen_by ORDER BY calls DESC"
    }
