  {
   "id": 8,
   "type": "table",
   "title": "Recent incidents — click a row's trace to inspect it",
   "description": "",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "rawSql": "SELECT Timestamp AS started, SpanAttributes['sentinel.incident_id'] AS incident, SpanAttributes['sentinel.outcome'] AS outcome, concat('v', SpanAttributes['sentinel.knowledge_version']) AS knowledge, SpanAttributes['sentinel.reasoning'] AS reasoning, toUInt8OrNull(SpanAttributes['sentinel.plan_attempts']) AS sandbox_attempts, toFloat64OrNull(SpanAttributes['sentinel.time_to_contain_s']) AS contain_s, concat(SpanAttributes['sentinel.paths_before'], ' → ', SpanAttributes['sentinel.paths_after']) AS attack_paths, Duration / 1e9 AS duration_s, TraceId AS trace_id FROM otel.otel_traces WHERE SpanName = 'incident' AND ServiceName = 'sentinel' AND $__timeFilter(Timestamp) ORDER BY Timestamp DESC LIMIT 50"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "trace_id"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Open this trace",
          "url": "/d/sentinel-agents/sentinel-agent-observability?var-trace_id=${__data.fields.trace_id}&${__url_time_range}"
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "outcome"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "resolved": {
            "color": "green",
            "index": 0
           },
           "failed": {
            "color": "red",
            "index": 1
           },
           "awaiting_approval": {
            "color": "orange",
            "index": 2
           }
          }
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "contain_s"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "duration_s"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   },
   "transformations": []
  },
  {
   "id": 9,
   "type": "row",
   "title": "Selected incident trace (pick one in the trace_id dropdown above)",
   "collapsed": false,
