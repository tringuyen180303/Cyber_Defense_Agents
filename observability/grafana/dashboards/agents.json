{
 "uid": "sentinel-agents",
 "title": "Sentinel · Agent observability",
 "description": "OpenTelemetry traces and logs of Sentinel's agents, stored in ClickHouse.",
 "tags": [
  "sentinel"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "time": {
