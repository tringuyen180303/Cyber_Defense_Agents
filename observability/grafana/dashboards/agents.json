   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "rawSql": "SELECT avg(SpanAttributes['sentinel.outcome'] = 'resolved') FROM otel.otel_traces WHERE SpanName = 'incident' AND ServiceName = 'sentinel' AND $__timeFilter(Timestamp)"
