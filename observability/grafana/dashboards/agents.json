      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   },
   "transformations": []
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Median time to verified containment",
   "description": "Wall-clock seconds from incident opened to production-verified containment (includes human approval wait when not auto-approved).",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "rawSql": "SELECT quantile(0.5)(toFloat64OrNull(SpanAttributes['sentinel.time_to_contain_s'])) FROM otel.otel_traces WHERE SpanName = 'incident' AND ServiceName = 'sentinel' AND $__timeFilter(Timestamp)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "purple",
        "value": null
       }
      ]
     },
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   },
   "transformations": []
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Plans passing sandbox first try",
   "description": "",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "rawSql": "SELECT avg(SpanAttributes['sentinel.sandbox_first_try'] = 'true') FROM otel.otel_traces WHERE SpanName = 'incident' AND ServiceName = 'sentinel' AND $__timeFilter(Timestamp) AND SpanAttributes['sentinel.plan_attempts'] != ''"
    }
   ],
