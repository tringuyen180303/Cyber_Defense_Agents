      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "rawSql": "SELECT count() FROM otel.otel_traces WHERE SpanName = 'incident' AND ServiceName = 'sentinel' AND $__timeFilter(Timestamp)"
