  {
   "id": 8,
   "type": "timeseries",
   "title": "API calls per hour — baseline vs incident replay",
   "description": "",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 24,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 0,
     "rawSql": "SELECT $__timeInterval(time) AS t, if(source = 'baseline', 'baseline (normal CI + prod)', if(ip IN (SELECT DISTINCT ip FROM sentinel.cloudtrail WHERE source = 'baseline'), 'incident window: known IPs', 'incident window: attacker IP')) AS series, count() AS calls FROM sentinel.cloudtrail WHERE $__timeFilter(time) AND (source = 'baseline' OR source = (SELECT max(source) FROM sentinel.cloudtrail WHERE source != 'baseline')) GROUP BY t, series ORDER BY t"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 25,
      "lineWidth": 2,
      "showPoints": "auto",
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "showLegend": true,
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "transformations": []
