  },
  {
   "id": 14,
   "type": "barchart",
   "title": "Hour-of-day activity by identity (baseline)",
   "description": "",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 33,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "rawSql": "SELECT toString(toHour(time)) AS hour_utc, countIf(origin_user = 'ci-deployer') AS ci_deployer, countIf(principal = 'prod-api-role') AS prod_api, countIf(origin_user = 'alice-admin') AS alice_admin FROM sentinel.cloudtrail WHERE source = 'baseline' GROUP BY toHour(time) AS h, hour_utc ORDER BY h"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "options": {
    "xField": "hour_utc",
    "orientation": "vertical",
    "showValue": "auto",
    "stacking": "normal",
    "legend": {
     "showLegend": true,
     "displayMode": "list",
     "placement": "bottom"
    },
    "xTickLabelRotation": 0,
    "barWidth": 0.7,
    "groupWidth": 0.7
   },
   "transformations": []
  },
  {
   "id": 15,
   "type": "table",
   "title": "Top actions per identity (baseline)",
   "description": "",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 12,
    "y": 33,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "rawSql": "SELECT origin_user AS identity, iam_action AS action, count() AS calls, uniq(ip) AS ips, uniq(resource_family) AS resources FROM sentinel.cloudtrail WHERE source = 'baseline' GROUP BY identity, action ORDER BY calls DESC LIMIT 25"
    }
