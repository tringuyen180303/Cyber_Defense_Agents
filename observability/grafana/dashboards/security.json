  {
   "id": 10,
   "type": "table",
   "title": "Source IPs never seen in 30 days",
   "description": "",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 15,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "rawSql": "SELECT ip, uniq(source) AS incidents, arrayStringConcat(groupUniqArray(principal), ', ') AS identities, count() AS calls, countIf(error != '') AS denied, min(time) AS first_seen, max(time) AS last_seen FROM sentinel.cloudtrail WHERE source != 'baseline' AND ip NOT IN (SELECT DISTINCT ip FROM sentinel.cloudtrail WHERE source = 'baseline') GROUP BY ip ORDER BY calls DESC"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   },
   "transformations": []
  },
  {
   "id": 11,
   "type": "table",
   "title": "Actions an identity had never performed",
   "description": "",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 12,
    "y": 15,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "rawSql": "WITH b AS (SELECT DISTINCT origin_user, iam_action FROM sentinel.cloudtrail WHERE source = 'baseline') SELECT l.origin_user AS identity, l.iam_action AS action, count() AS calls, countIf(l.error != '') AS denied FROM sentinel.cloudtrail AS l LEFT ANTI JOIN b USING (origin_user, iam_action) WHERE l.source = (SELECT max(source) FROM sentinel.cloudtrail WHERE source != 'baseline') GROUP BY identity, action ORDER BY calls DESC"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   },
   "transformations": []
  },
  {
   "id": 12,
   "type": "table",
   "title": "Attacker kill chain (calls from never-seen IPs)",
   "description": "",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 22,
    "w": 24,
    "h": 10
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "rawSql": "SELECT time, event_name, principal, principal_type AS type, access_key, resource, if(error = '', 'ok', error) AS result, user_agent FROM sentinel.cloudtrail WHERE source = (SELECT max(source) FROM sentinel.cloudtrail WHERE source != 'baseline') AND ip NOT IN (SELECT DISTINCT ip FROM sentinel.cloudtrail WHERE source = 'baseline') ORDER BY time"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "result"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "ok": {
            "color": "green",
            "index": 0
           }
          }
         },
         {
          "type": "regex",
          "options": {
           "pattern": ".+",
           "result": {
            "color": "red",
            "index": 1
           }
          }
         }
        ]
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   },
   "transformations": []
  },
