  {
   "id": 8,
   "type": "barchart",
   "title": "Detection quality by knowledge version",
   "description": "",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "rawSql": "SELECT concat('v', toString(knowledge_version)) AS version, avgIf(detected, label = 'attack') AS recall, avg(correct) AS accuracy, avgIf(plan_attempts = 1, detected AND label = 'attack') AS first_try_plans FROM sentinel.eval_results GROUP BY knowledge_version ORDER BY knowledge_version"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "options": {
    "xField": "version",
    "orientation": "vertical",
    "showValue": "auto",
    "stacking": "none",
    "legend": {
     "showLegend": true,
     "displayMode": "list",
     "placement": "bottom"
    },
    "xTickLabelRotation": 0,
    "barWidth": 0.7,
    "groupWidth": 0.7
   },
   "transformations": []
  },
  {
   "id": 9,
   "type": "barchart",
   "title": "Mistakes by knowledge version",
   "description": "",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 12,
    "y": 5,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "rawSql": "SELECT concat('v', toString(knowledge_version)) AS version, countIf(NOT detected AND label = 'attack') AS missed_attacks, countIf(detected AND label = 'benign') AS false_positives, sumIf(plan_attempts - 1, detected AND plan_attempts > 1) AS extra_sandbox_attempts FROM sentinel.eval_results GROUP BY knowledge_version ORDER BY knowledge_version"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "options": {
    "xField": "version",
    "orientation": "vertical",
    "showValue": "auto",
    "stacking": "normal",
    "legend": {
     "showLegend": true,
     "displayMode": "list",
     "placement": "bottom"
    },
    "xTickLabelRotation": 0,
    "barWidth": 0.7,
    "groupWidth": 0.7
   },
   "transformations": []
  },
  {
   "id": 10,
   "type": "table",
   "title": "Scenario × version (✓ correct · ✗ wrong; ⚔ = discovered by the red team)",
   "description": "",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 24,
    "h": 11
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "rawSql": "SELECT concat(if(startsWith(scenario, 'rt-'), '⚔ ', ''), scenario, ' [', label, ']') AS scenario, concat('v', toString(knowledge_version)) AS version, if(correct, if(label = 'attack', concat('✓ ', toString(ifNull(plan_attempts, 0)), ' try'), '✓'), if(label = 'attack', '✗ missed', '✗ false alarm')) AS result FROM sentinel.eval_results ORDER BY scenario, knowledge_version LIMIT 1 BY scenario, knowledge_version"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "cellOptions": {
       "type": "color-text"
      }
     },
     "mappings": [
      {
       "type": "regex",
       "options": {
        "pattern": "✓.*",
        "result": {
         "color": "green",
         "index": 0
        }
       }
      },
      {
       "type": "regex",
       "options": {
        "pattern": "✗.*",
        "result": {
         "color": "red",
         "index": 1
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   },
   "transformations": [
    {
     "id": "groupingToMatrix",
     "options": {
      "columnField": "version",
      "rowField": "scenario",
      "valueField": "result",
      "emptyValue": "null"
     }
    }
   ]
  },
  {
   "id": 11,
