  {
   "id": 12,
   "type": "table",
   "title": "Every candidate change the evaluator gate tested",
   "description": "",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 26,
    "w": 24,
    "h": 10
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "rawSql": "SELECT Timestamp AS time, SpanAttributes['sentinel.change_type'] AS type, SpanAttributes['sentinel.change'] AS change, SpanAttributes['sentinel.trigger'] AS triggered_by, SpanAttributes['sentinel.verdict_detail'] AS verdict, SpanAttributes['sentinel.recall'] AS recall, SpanAttributes['sentinel.false_positives'] AS fp FROM otel.otel_traces WHERE SpanName = 'learning.candidate' AND $__timeFilter(Timestamp) ORDER BY Timestamp DESC LIMIT 100"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "verdict"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "regex",
          "options": {
           "pattern": "improves",
           "result": {
            "color": "green",
            "index": 0
           }
          }
         },
         {
          "type": "regex",
          "options": {
           "pattern": "rejected.*",
           "result": {
            "color": "red",
            "index": 1
           }
          }
         }
        ]
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   },
   "transformations": []
  },
